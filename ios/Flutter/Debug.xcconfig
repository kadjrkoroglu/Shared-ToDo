#include "Generated.xcconfig"

// Xcode 27's `lipo` rejects `-verify_arch` with multiple architectures, which
// breaks Flutter's `debug_unpack_ios` step on simulator builds. Keep the
// simulator build on a single (native) architecture.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
ONLY_ACTIVE_ARCH = YES
